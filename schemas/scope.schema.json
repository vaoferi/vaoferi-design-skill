{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vaoferi.design/schemas/scope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "profile", "paths", "routes", "contractPath"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "public-content",
        "marketing-editorial",
        "application-standard",
        "admin-standard",
        "admin-dense",
        "custom-approved"
      ]
    },
    "paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "routes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "excludeRoutes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "entrypoints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "sharedWith": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "contractPath": {
      "type": "string",
      "minLength": 1
    }
  }
}
