{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaoferi.dev/schemas/baseline.schema.json",
  "title": "Vaoferi Design Verifier Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "file", "line"],
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
