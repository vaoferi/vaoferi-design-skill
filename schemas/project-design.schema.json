{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vaoferi.design/schemas/project-design.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "scopes"],
  "properties": {
    "contractVersion": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "scope.schema.json"
      }
    },
    "defaultScopeId": {
      "type": "string",
      "minLength": 1
    }
  }
}
