{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vaoferi.dev/schemas/design-contract/status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "rhythm", "place", "align", "flow", "reference", "visual", "responsive"],
      "properties": {
        "frame": { "$ref": "#/definitions/stageStatus" },
        "rhythm": { "$ref": "#/definitions/stageStatus" },
        "place": { "$ref": "#/definitions/stageStatus" },
        "align": { "$ref": "#/definitions/stageStatus" },
        "flow": { "$ref": "#/definitions/stageStatus" },
        "reference": { "$ref": "#/definitions/stageStatus" },
        "visual": { "$ref": "#/definitions/stageStatus" },
        "responsive": { "$ref": "#/definitions/stageStatus" }
      }
    }
  },
  "definitions": {
    "stageStatus": {
      "type": "string",
      "enum": ["missing", "proposed", "approved", "stale"]
    }
  }
}
